# ═══════════════════════════════════════════════
# VEORI AI Backend — Environment Variables
# Copy to .env for local development
# All vars are set in Railway dashboard for production
# ═══════════════════════════════════════════════

PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://xqllxyoeftkbufoungcz.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Auth
JWT_SECRET=change_this_to_a_long_random_string_in_production

# Anthropic (Claude Haiku 4.5)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Vapi.ai
VAPI_API_KEY=your_vapi_api_key_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_WEBHOOK_SECRET=your_webhook_secret

# OpenAI (GPT-4o for qualification, conversation intelligence, insights)
OPENAI_API_KEY=sk-your_openai_key_here

# Dropbox Sign (white-label e-signing — zero Dropbox branding in UI)
DROPBOX_SIGN_API_KEY=your_dropbox_sign_api_key_here

# Redis (BullMQ job queue — Railway Redis addon or Upstash)
REDIS_URL=redis://localhost:6379

# OPTIONAL: ElevenLabs only powers the listing-video voiceover feature (not phone calls).
# Phone + voicemail voice is Vapi-native via VAPI_VOICE_ID. Leave unset to skip listing voiceover.
# ELEVENLABS_API_KEY=

# Lob.com (direct mail postcards)
LOB_API_KEY=test_your_lob_api_key_here

# BatchSkipTracing
BATCH_SKIP_TRACE_API_KEY=your_batchskiptracing_key

# Email (SMTP — for follow-up sequences)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=Alex from Veori <noreply@veori.ai>

# Vapi model override (optional — defaults to claude-haiku-4-5)
# VAPI_AI_MODEL=claude-haiku-4-5
# VAPI_BASE_URL=https://api.vapi.ai

# S4 — Field-level PII encryption (AES-256-GCM). OPTIONAL.
# When set, full bank routing/account numbers are stored encrypted (not just masked).
# Use 64 hex chars (32 bytes): `openssl rand -hex 32`. If unset, the app falls back
# to the existing masked-stub behavior (***last4) — never plaintext.
# PII_ENCRYPTION_KEY=your_64_char_hex_key_here

# Feature A — Property imagery (aerial + street view). OPTIONAL.
# Enables the "Property Imagery" section on the Lead Intelligence page. Uses
# Google's Static Maps API (satellite) + Street View Static API, derived from the
# lead's address. If unset, the imagery section shows "unavailable" and nothing
# else changes. Enable both "Maps Static API" and "Street View Static API" on the
# key. GOOGLE_MAPS_SIGNING_SECRET is only needed if your account requires signed
# Static API requests.
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# GOOGLE_MAPS_SIGNING_SECRET=your_url_signing_secret_here

# Frontend (CORS)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-app.vercel.app

# Railway auto-injects RAILWAY_PUBLIC_DOMAIN
# RAILWAY_PUBLIC_DOMAIN=your-app.railway.app
